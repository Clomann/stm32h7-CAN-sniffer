{
  "version": "2.0.0",
  "tasks": [
     {
      "label": "cppcheck",
      "type": "shell",
      "command": "bash",
      "args": [
        "-c",
        "cppcheck --enable=all --inconclusive --std=c11 --force \
        --suppressions-list=dev/tools/cppcheck/cppcheck-suppressions.txt \
        --project=build/compile_commands.json --rule-file=dev/tools/cppcheck/rules.xml \w
        2> _bin/cppcheck_report.txt"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "Flash CM7 Boot",
      "type": "shell",
      "command": "STM32_Programmer_CLI",
      "args": [
        "-c", "port=SWD",
        "-d", "_bin/Debug/SPI_FullDuplex_ComDMA_CM7_boot.elf", "0x08000000",
        "-rst"
      ],
      "presentation": {
        "echo": true,
        "reveal": "always"
      },
      "problemMatcher": []
    },
    {
      "label": "Flash CM7 App",
      "type": "shell",
      "command": "STM32_Programmer_CLI",
      "args": [
        "-c", "port=SWD",
        "-d", "_bin/Debug/SPI_FullDuplex_ComDMA_CM7_app-signed.bin", "0x08020000",
        "-rst"
      ],
      "presentation": {
        "echo": true,
        "reveal": "always"
      },
      "problemMatcher": []
    },
    {
      "label": "Flash CM4",
      "type": "shell",
      "command": "STM32_Programmer_CLI",
      "args": [
        "-c", "port=SWD",
        "-d", "_bin/Debug/SPI_FullDuplex_ComDMA_CM4_app.elf", "0x08100000",
        "-rst"
      ],
      "presentation": {
        "echo": true,
        "reveal": "always"
      },
      "problemMatcher": []
    },
    {
      "label": "Flash CM7 Boot (Release)",
      "type": "shell",
      "command": "STM32_Programmer_CLI",
      "args": [
        "-c", "port=SWD",
        "-d", "_bin/Release/SPI_FullDuplex_ComDMA_CM7_boot.elf", "0x08000000",
        "-rst"
      ],
      "presentation": {
        "echo": true,
        "reveal": "always"
      },
      "problemMatcher": []
    },
    {
      "label": "Flash CM7 App (Release)",
      "type": "shell",
      "command": "STM32_Programmer_CLI",
      "args": [
        "-c", "port=SWD",
        "-d", "_bin/Release/SPI_FullDuplex_ComDMA_CM7_app-signed.bin", "0x08020000",
        "-rst"
      ],
      "presentation": {
        "echo": true,
        "reveal": "always"
      },
      "problemMatcher": []
    },
    {
      "label": "Flash CM4 (Release)",
      "type": "shell",
      "command": "STM32_Programmer_CLI",
      "args": [
        "-c", "port=SWD",
        "-d", "_bin/Release/SPI_FullDuplex_ComDMA_CM4_app.elf", "0x08100000",
        "-rst"
      ],
      "presentation": {
        "echo": true,
        "reveal": "always"
      },
      "problemMatcher": []
    },
    {
      "label": "Start OpenOCD",
      "type": "shell",
      "command": "/usr/local/bin/openocd",
      "args": [
        "-s", "/usr/local/Cellar/open-ocd/0.12.0_1/share/openocd/scripts/",
        "-f", "interface/stlink-dap.cfg",
        "-f", "target/stm32h7x_dual_bank.cfg",
        "-c", "adapter speed 1000",
        "-c", "reset_config srst_only srst_nogate connect_deassert_srst",
        "-c", "init; \
            targets stm32h7x.cpu0; \
            if {[catch {targets stm32h7x.cpu1}]} {echo \"CM4 not available\"}; \
            targets stm32h7x.cpu0; \
            mmw 0x580244A0 0x8 0x0; \
            reset run"
      ],
      "isBackground": true,
      "presentation": {
        "echo": true,
        "reveal": "always"
      },
      "problemMatcher": {
        "pattern": [
          {
            "regexp": ".",
            "file": 1,
            "location": 2,
            "message": 3
          }
        ],
        "background": {
          "activeOnStart": true,
          "beginsPattern": "Info\\s?:.*Listening on port.*",
          "endsPattern": ".*"
        }
      }
    },
    {
      "label": "Flash CM7 Boot & App",
      "dependsOn": ["Flash CM7 Boot", "Flash CM7 App"],
      "dependsOrder": "sequence"
    },
    {
      "label": "Flash CM7 & CM4",
      "dependsOn": ["Flash CM7 Boot & App", "Flash CM4"],
      "dependsOrder": "sequence"
    },
    {
      "label": "Flash CM7 & CM4 and start OpenOCD",
      "dependsOn": ["Flash CM7 & CM4", "Start OpenOCD"],
      "dependsOrder": "sequence"
    },
    {
      "label": "Flash CM7 Boot & App (Release)",
      "dependsOn": ["Flash CM7 Boot (Release)", "Flash CM7 App (Release)"],
      "dependsOrder": "sequence"
    },
    {
      "label": "Flash CM7 & CM4 (Release)",
      "dependsOn": ["Flash CM7 Boot & App (Release)", "Flash CM4 (Release)"],
      "dependsOrder": "sequence"
    },
    {
      "label": "Flash CM7 & CM4 and start OpenOCD (Release)",
      "dependsOn": ["Flash CM7 & CM4 (Release)", "Start OpenOCD"],
      "dependsOrder": "sequence"
    },
    {
      "label": "Start Debug Session",
      "dependsOn": ["Start OpenOCD"],
      "dependsOrder": "sequence"
    },
    {
      "label": "Start OpenOCD Session",
      "dependsOn": ["Start OpenOCD"],
      "dependsOrder": "sequence"
    }
  ]
}

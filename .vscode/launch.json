{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug CM7 (Attach)",
            "type": "cortex-debug",
            "request": "attach",
            "servertype": "external",
            "preLaunchCommands": [
                "set mem inaccessible-by-default off",
                "set breakpoint pending on",
                "set remote hardware-breakpoint-limit unlimited",
                "monitor reset halt",
                "monitor program _bin/Release/SPI_FullDuplex_ComDMA_CM7_boot.elf verify",
                "monitor program _bin/Release/SPI_FullDuplex_ComDMA_CM7_app-signed.bin 0x08020000 verify",
                "monitor reset run"
            ],
            "postAttachCommands": [
                "symbol-file _bin/Release/SPI_FullDuplex_ComDMA_CM7_boot.elf",
                "add-symbol-file _bin/Release/SPI_FullDuplex_ComDMA_CM7_app.elf 0x080206a0"
            ],
            "useHardwareBreakpoints": true,
            "gdbTarget": "localhost:3333",
            "cwd": "${workspaceFolder}",
            "device": "STM32H745ZITx_M7",
            "executable": "${workspaceFolder}/_bin/Debug/SPI_FullDuplex_ComDMA_CM7_app.elf"
        },
        {
            "name": "Debug CM4 (Attach)",
            "type": "cortex-debug",
            "request": "attach",
            "servertype": "external",
            "preLaunchCommands": [
                "set mem inaccessible-by-default off",
                "set breakpoint pending on",
                "set remote hardware-breakpoint-limit unlimited"
            ],
            "useHardwareBreakpoints": true,
            "gdbTarget": "localhost:3334",
            "cwd": "${workspaceFolder}",
            "device": "STM32H745ZITx_M4",
            "executable": "${workspaceFolder}/_bin/Debug/SPI_FullDuplex_ComDMA_CM4_app.elf"
        },
        {
            "name": "Release CM7 (Attach)",
            "type": "cortex-debug",
            "request": "attach",
            "servertype": "external",
            "preLaunchCommands": [
                "set mem inaccessible-by-default off",
                "set breakpoint pending on",
                "set remote hardware-breakpoint-limit unlimited",
                "monitor reset halt",
                "monitor program ${workspaceFolder}/_bin/Release/SPI_FullDuplex_ComDMA_CM7_boot.elf verify",
                "monitor program ${workspaceFolder}/_bin/Release/SPI_FullDuplex_ComDMA_CM7_app-signed.bin 0x08020000 verify",
                "monitor reset run"
            ],
            "postAttachCommands": [
                "symbol-file ${workspaceFolder}/_bin/Release/SPI_FullDuplex_ComDMA_CM7_boot.elf",
                "add-symbol-file ${workspaceFolder}/_bin/Release/SPI_FullDuplex_ComDMA_CM7_app.elf 0x080206a0"
            ],
            "useHardwareBreakpoints": true,
            "gdbTarget": "localhost:3333",
            "cwd": "${workspaceFolder}",
            "device": "STM32H745ZITx_M7",
            "executable": "${workspaceFolder}/_bin/Release/SPI_FullDuplex_ComDMA_CM7_app.elf"
        },
        {
            "name": "Release CM4 (Attach)",
            "type": "cortex-debug",
            "request": "attach",
            "servertype": "external",
            "preLaunchCommands": [
                "set mem inaccessible-by-default off",
                "set breakpoint pending on",
                "set remote hardware-breakpoint-limit unlimited"
            ],
            "useHardwareBreakpoints": true,
            "gdbTarget": "localhost:3334",
            "cwd": "${workspaceFolder}",
            "device": "STM32H745ZITx_M4",
            "executable": "${workspaceFolder}/_bin/Release/SPI_FullDuplex_ComDMA_CM4_app.elf"
        },
        {
            "name": "Debug fdcan (LLDB)",
            "type": "lldb",
            "request": "launch",
            "program": "${workspaceFolder}/tests/build/test_fdcan",
            "args": [],
            "cwd": "${workspaceFolder}",
            "stopOnEntry": false,
            "stdio": [null, null, null]
        },
        {
            "name": "Debug app (LLDB)",
            "type": "lldb",
            "request": "launch",
            "program": "${workspaceFolder}/tests/build/test_app",
            "args": [],
            "cwd": "${workspaceFolder}",
            "stopOnEntry": false,
            "stdio": [null, null, null]
        },
        {
            "name": "Debug bootloader (LLDB)",
            "type": "lldb",
            "request": "launch",
            "program": "${workspaceFolder}/tests/build/test_bootloader",
            "args": [],
            "cwd": "${workspaceFolder}",
            "stopOnEntry": false,
            "stdio": [null, null, null]
        }
    ],
    "compounds": [
        {
            "name": "Attach Both Cores",
            "configurations": [
                "Debug CM7 (Attach)",
                "Debug CM4 (Attach)"
            ],
            "stopAll": false
        },
        {
            "name": "Start Dual-Core Debug Session",
            "configurations": [
                "Debug CM7 (Attach)",
                "Debug CM4 (Attach)"
            ],
            "preLaunchTask": "Start Debug Session",
            "stopAll": false
        },
        {
            "name": "Flash & Start Dual-Core Debug Session",
            "configurations": [
                "Debug CM7 (Attach)",
                "Debug CM4 (Attach)"
            ],
            "preLaunchTask": "Flash CM7 & CM4 and start OpenOCD",
            "stopAll": false
        },
        {
            "name": "Start Dual-Core Release Session",
            "configurations": [
                "Release CM7 (Attach)",
                "Release CM4 (Attach)"
            ],
            "preLaunchTask": "Start OpenOCD Session",
            "stopAll": false
        },
        {
            "name": "Flash & Start Dual-Core Debug Session (Release)",
            "configurations": [
                "Release CM7 (Attach)",
                "Release CM4 (Attach)"
            ],
            "preLaunchTask": "Flash CM7 & CM4 and start OpenOCD (Release)",
            "stopAll": false
        }
    ]
}

{
    "version": 6,
    "configurePresets": [
        {
            "name": "default",
            "hidden": true,
            "generator": "Unix Makefiles",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "toolchainFile": "${sourceDir}/gcc-arm-none-eabi.cmake",
            "cacheVariables": {
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
            }
        },
        {
            "name": "Debug",
            "inherits": "default",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "DUAL_CORE": "false",
                "CORE": "CM7"
            }
        },
        {
            "name": "Debug_CM7",
            "inherits": "default",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CORE": "CM7",
                "DUAL_CORE": "true"
            }
        },
        {
            "name": "Debug_CM7_Boot",
            "inherits": "default",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CORE": "CM7",
                "DUAL_CORE": "true",
                "BUILD_TARGET": "bootloader"
            }
        },
        {
            "name": "Debug_CM7_Both",
            "inherits": "default",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CORE": "CM7",
                "DUAL_CORE": "true",
                "BUILD_TARGET": "both"
            }
        },
        {
            "name": "Debug_CM4",
            "inherits": "default",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CORE": "CM4",
                "DUAL_CORE": "true"
            }
        },
        {
            "name": "Release_CM7",
            "inherits": "default",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "CORE": "CM7",
                "DUAL_CORE": "true"
            }
        },
        {
            "name": "Release_CM7_Boot",
            "inherits": "default",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "CORE": "CM7",
                "DUAL_CORE": "true",
                "BUILD_TARGET": "bootloader"
            }
        },
        {
            "name": "Release_CM7_Both",
            "inherits": "default",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "CORE": "CM7",
                "DUAL_CORE": "true",
                "BUILD_TARGET": "both"
            }
        },
        {
            "name": "Release_CM4",
            "inherits": "default",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "CORE": "CM4",
                "DUAL_CORE": "true"
            }
        }
    ],
    "buildPresets": [
        { 
            "name": "debug-build", 
            "configurePreset": "Debug", 
            "jobs": 4,
            "cleanFirst": true
        },
        { 
            "name": "debug-build-cm7", 
            "configurePreset": "Debug_CM7", 
            "jobs": 4,
            "cleanFirst": true
        },
        { 
            "name": "debug-build-cm7-boot", 
            "configurePreset": "Debug_CM7_Boot", 
            "jobs": 4,
            "cleanFirst": true
        },
        { 
            "name": "debug-build-cm7-both", 
            "configurePreset": "Debug_CM7_Both", 
            "jobs": 4,
            "cleanFirst": true
        },
        { 
            "name": "debug-build-cm4", 
            "configurePreset": "Debug_CM4", 
            "jobs": 4,
            "cleanFirst": true
        },
        { 
            "name": "release-build-cm7", 
            "configurePreset": "Release_CM7", 
            "jobs": 4,
            "cleanFirst": true
        },
        { 
            "name": "release-build-cm7-boot", 
            "configurePreset": "Release_CM7_Boot", 
            "jobs": 4,
            "cleanFirst": true
        },
        { 
            "name": "release-build-cm7-both", 
            "configurePreset": "Release_CM7_Both", 
            "jobs": 4,
            "cleanFirst": true
        },
        { 
            "name": "release-build-cm4", 
            "configurePreset": "Release_CM4", 
            "jobs": 4,
            "cleanFirst": true
        }
    ],
    "workflowPresets": [
        {
            "description": "Developer workflow",
            "name": "debug-all",
            "steps": [
                { 
                    "type": "configure",
                    "name": "Debug"
                },
                { 
                    "type": "build",
                    "name": "debug-build"
                }
            ]
        },
        {
            "description": "Developer workflow",
            "name": "debug-cm7",
            "steps": [
                { 
                    "type": "configure",
                    "name": "Debug_CM7"
                },
                { 
                    "type": "build",
                    "name": "debug-build-cm7"
                }
            ]
        },
        {
            "description": "Developer workflow (CM7, bootloader only)",
            "name": "debug-cm7-boot",
            "steps": [
                { 
                    "type": "configure",
                    "name": "Debug_CM7_Boot"
                },
                { 
                    "type": "build",
                    "name": "debug-build-cm7-boot"
                }
            ]
        },
        {
            "description": "Developer workflow (CM7, app+boot)",
            "name": "debug-cm7-both",
            "steps": [
                { 
                    "type": "configure",
                    "name": "Debug_CM7_Both"
                },
                { 
                    "type": "build",
                    "name": "debug-build-cm7-both"
                }
            ]
        },
        {
            "description": "Developer workflow",
            "name": "debug-cm4",
            "steps": [
                { 
                    "type": "configure",
                    "name": "Debug_CM4"
                },
                { 
                    "type": "build",
                    "name": "debug-build-cm4"
                }
            ]
        },
        {
            "description": "Release workflow (CM7)",
            "name": "release-cm7",
            "steps": [
                { 
                    "type": "configure",
                    "name": "Release_CM7"
                },
                { 
                    "type": "build",
                    "name": "release-build-cm7"
                }
            ]
        },
        {
            "description": "Release workflow (CM7, bootloader only)",
            "name": "release-cm7-boot",
            "steps": [
                { 
                    "type": "configure",
                    "name": "Release_CM7_Boot"
                },
                { 
                    "type": "build",
                    "name": "release-build-cm7-boot"
                }
            ]
        },
        {
            "description": "Release workflow (CM7, app+boot)",
            "name": "release-cm7-both",
            "steps": [
                { 
                    "type": "configure",
                    "name": "Release_CM7_Both"
                },
                { 
                    "type": "build",
                    "name": "release-build-cm7-both"
                }
            ]
        },
        {
            "description": "Release workflow (CM4)",
            "name": "release-cm4",
            "steps": [
                { 
                    "type": "configure",
                    "name": "Release_CM4"
                },
                { 
                    "type": "build",
                    "name": "release-build-cm4"
                }
            ]
        }
    ]
}
